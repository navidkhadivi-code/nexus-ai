# NEXUS AI — environment template (VPS build). NEVER commit a real .env.
NODE_ENV=production

# --- database (VPS roadmap) ---
DATABASE_URL=postgresql://nexus:CHANGE_ME@localhost:5432/nexus?schema=public
REDIS_URL=redis://localhost:6379

# --- secrets ---
JWT_SECRET=CHANGE_ME_64_random_bytes
JWT_REFRESH_SECRET=CHANGE_ME_64_random_bytes
CRED_ENCRYPTION_KEY=CHANGE_ME_AES256_GCM_KEY

# --- market data (public keys optional for higher rate limits) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# --- AI provider (optional, VPS build only) ---
AI_PROVIDER=none            # none | openai | anthropic | local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- alerts ---
TELEGRAM_BOT_TOKEN=
SMTP_URL=

# --- safety ---
LIVE_TRADING_ENABLED=false  # must be flipped through admin panel + 2FA, never by env alone
